{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Chute",
  "scopeName": "source.chute",
  "patterns": [
    { "include": "#comments" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#literals" },
    { "include": "#strings" },
    { "include": "#types" },
    { "include": "#declarations" },
    { "include": "#function-calls" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.chute",
          "begin": "/\\*\\*(?!/)",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.chute" }
          }
        },
        {
          "name": "comment.block.chute",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.chute" }
          }
        },
        {
          "name": "comment.line.documentation.chute",
          "match": "(///)(.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.chute" }
          }
        },
        {
          "name": "comment.line.double-slash.chute",
          "match": "(//)(.*)$",
          "captures": {
            "1": { "name": "punctuation.definition.comment.chute" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.chute",
          "match": "\\b(if|else|for|in|repeat|return|menu|case)\\b"
        },
        {
          "name": "keyword.declaration.chute",
          "match": "\\b(const|let|func|action|enum|record|shortcut)\\b"
        },
        {
          "name": "keyword.other.chute",
          "match": "\\b(import|export|as|is)\\b"
        },
        {
          "name": "keyword.operator.word.chute",
          "match": "\\b(contains|hasPrefix|hasSuffix)\\b|!contains\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipeline.chute",
          "match": "\\|>\\??"
        },
        {
          "name": "keyword.operator.logical.chute",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.comparison.chute",
          "match": "==|!=|<=|>="
        },
        {
          "name": "keyword.operator.arithmetic.chute",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.assignment.chute",
          "match": "="
        },
        {
          "name": "keyword.operator.spread.chute",
          "match": "\\.\\.\\."
        },
        {
          "name": "keyword.operator.nil-coalesce.chute",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.ternary.chute",
          "match": "\\?|:"
        },
        {
          "name": "keyword.operator.arrow.chute",
          "match": "->"
        },
        {
          "name": "keyword.operator.optional-chain.chute",
          "match": "\\?\\."
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.braces.chute",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.chute",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.chute",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.chute",
          "match": "[;,.]"
        },
        {
          "name": "punctuation.definition.attribute.chute",
          "match": "@"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.float.chute",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.chute",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "constant.language.boolean.chute",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.chute",
          "match": "\\bnil\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        { "include": "#raw-string" },
        { "include": "#string-literal" }
      ]
    },
    "raw-string": {
      "patterns": [
        {
          "name": "string.quoted.other.raw.chute",
          "begin": "(##+(\"))",
          "end": "(\"##+)",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.chute" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.chute" } }
        },
        {
          "name": "string.quoted.other.raw.chute",
          "begin": "(#\")",
          "end": "(\"#)",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.chute" } },
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.chute" } }
        }
      ]
    },
    "string-literal": {
      "name": "string.quoted.double.chute",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.chute" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.chute" }
      },
      "patterns": [
        { "include": "#string-interpolation" },
        { "include": "#string-escape" },
        {
          "name": "string.quoted.double.chute",
          "match": "[^\"\\\\$]+"
        }
      ]
    },
    "string-interpolation": {
      "name": "meta.interpolation.chute",
      "begin": "(\\$\\{)",
      "end": "(\\})",
      "beginCaptures": {
        "1": { "name": "punctuation.section.interpolation.begin.chute" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.section.interpolation.end.chute" }
      },
      "patterns": [
        { "include": "#comments" },
        { "include": "#keywords" },
        { "include": "#operators" },
        { "include": "#punctuation" },
        { "include": "#literals" },
        { "include": "#strings" },
        { "include": "#types" },
        { "include": "#declarations" },
        { "include": "#function-calls" },
        { "include": "#identifiers" }
      ]
    },
    "string-escape": {
      "name": "constant.character.escape.chute",
      "match": "\\\\."
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.chute",
          "match": "\\b(List|Quantity)\\b"
        },
        {
          "name": "storage.type.chute",
          "match": "(?<=:\\s*)([A-Z][a-zA-Z0-9_]*)(?:\\.([A-Z][a-zA-Z0-9_]*))?",
          "captures": {
            "1": { "name": "entity.name.type.chute" },
            "2": { "name": "entity.name.type.chute" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "function declaration",
          "match": "\\b(func)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.chute" },
            "2": { "name": "entity.name.function.chute" }
          }
        },
        {
          "comment": "action declaration",
          "match": "\\b(action)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.chute" },
            "2": { "name": "entity.name.function.chute" }
          }
        },
        {
          "comment": "enum declaration",
          "match": "\\b(enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.chute" },
            "2": { "name": "entity.name.type.definition.chute" }
          }
        },
        {
          "comment": "record declaration",
          "match": "\\b(record)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.chute" },
            "2": { "name": "entity.name.type.definition.chute" }
          }
        },
        {
          "comment": "import statement",
          "match": "\\b(import)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s+(as)\\s+([a-zA-Z_][a-zA-Z0-9_]*))?",
          "captures": {
            "1": { "name": "keyword.other.chute" },
            "2": { "name": "entity.name.namespace.chute" },
            "3": { "name": "keyword.other.chute" },
            "4": { "name": "entity.name.namespace.chute" }
          }
        },
        {
          "comment": "attribute",
          "match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.attribute.chute" },
            "2": { "name": "entity.name.attribute.chute" }
          }
        },
        {
          "comment": "dot-name enum reference (.SomeCase)",
          "match": "(?<=[^a-zA-Z0-9_])\\.([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "variable.other.enummember.chute" }
          }
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "comment": "method call: object.method(",
          "match": "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.member.chute" }
          }
        },
        {
          "comment": "function call: name(",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.chute" }
          }
        },
        {
          "comment": "argument label: label:",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=:(?!:))",
          "captures": {
            "1": { "name": "variable.parameter.chute" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.language.index.chute",
          "match": "#index\\b"
        },
        {
          "name": "variable.language.placeholder.chute",
          "match": "\\b_\\b"
        },
        {
          "name": "variable.other.chute",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
