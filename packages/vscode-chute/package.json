{
  "name": "vscode-chute",
  "displayName": "Chute",
  "version": "0.0.1",
  "description": "Chute language support — syntax highlighting, diagnostics, completions, and go-to-definition",
  "categories": [
    "Programming Languages"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chutelang/chute.git",
    "directory": "packages/vscode-chute"
  },
  "publisher": "chutelang",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "~1.75.0",
    "@vscode/vsce": "^3.0.0",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "contributes": {
    "languages": [
      {
        "id": "chute",
        "aliases": [
          "Chute"
        ],
        "extensions": [
          ".chute"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "chute",
        "scopeName": "source.chute",
        "path": "./syntaxes/chute.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Chute",
      "properties": {
        "chute.lsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Chute language server"
        },
        "chute.lsp.serverPath": {
          "type": "string",
          "default": "",
          "description": "Path to the chute binary. Leave empty to use the binary on PATH."
        },
        "chute.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between VS Code and the Chute language server"
        }
      }
    }
  },
  "activationEvents": [],
  "engines": {
    "vscode": "^1.75.0"
  }
}
